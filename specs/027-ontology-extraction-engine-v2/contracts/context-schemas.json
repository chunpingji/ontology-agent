{
  "protocol_version": "ontology-tool-extraction-v1",
  "note": "控制层输入 Schema，不是新增模型回答阶段。仅通过本地已注册制品解析 $ref，禁止联网解析；urn:ontology-tool-extraction:discovery 映射 stage-schemas.json 的 discovery 子对象；local_ref_map 是唯一允许动态键的局部引用映射。",
  "verification_input": {
    "type": "object",
    "properties": {
      "discovery_ref": {
        "type": "string"
      },
      "targets": {
        "type": "array",
        "items": {
          "$ref": "context-schemas.json#/$defs/VerificationTargetSpec"
        }
      },
      "local_ref_map": {
        "type": "object",
        "additionalProperties": {
          "$ref": "context-schemas.json#/$defs/VersionedRef"
        }
      },
      "entity_dependencies": {
        "type": "array",
        "items": {
          "$ref": "context-schemas.json#/$defs/EntityDependencyView"
        }
      },
      "external_candidates": {
        "type": "array",
        "items": {
          "$ref": "context-schemas.json#/$defs/ExternalCandidate"
        }
      },
      "bridge_dependencies": {
        "type": "array",
        "items": {
          "$ref": "context-schemas.json#/$defs/BridgeDependencyView"
        }
      },
      "scope_resolutions": {
        "type": "array",
        "items": {
          "$ref": "context-schemas.json#/$defs/VerificationScopeResolution"
        }
      }
    },
    "required": [
      "discovery_ref",
      "targets",
      "local_ref_map",
      "entity_dependencies",
      "external_candidates",
      "bridge_dependencies",
      "scope_resolutions"
    ],
    "additionalProperties": false
  },
  "context_authorization": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "ir_identity": {
        "$ref": "context-schemas.json#/$defs/IRIdentity"
      },
      "context_policy_hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "record_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "fragments": {
        "type": "array",
        "items": {
          "$ref": "context-schemas.json#/$defs/AuthorizedFragment"
        }
      },
      "bindings": {
        "$ref": "context-schemas.json#/$defs/ContextBindingRefs"
      }
    },
    "required": [
      "task_id",
      "ir_identity",
      "context_policy_hash",
      "record_ids",
      "fragments",
      "bindings"
    ],
    "additionalProperties": false
  },
  "tool_protocol_error_observation": {
    "type": "object",
    "properties": {
      "request_attempt": {
        "type": "integer",
        "minimum": 1
      },
      "call": {
        "$ref": "context-schemas.json#/$defs/ToolCall"
      },
      "parsed_arguments": {
        "type": "null"
      },
      "result_ref": {
        "type": "string"
      },
      "result": {
        "$ref": "context-schemas.json#/$defs/ToolErrorResult"
      }
    },
    "required": [
      "request_attempt",
      "call",
      "parsed_arguments",
      "result_ref",
      "result"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "VersionedRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "IRIdentity": {
      "type": "object",
      "properties": {
        "document_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parser_version": {
          "type": "string"
        },
        "structure_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "document_hash",
        "parser_version",
        "structure_hash"
      ],
      "additionalProperties": false
    },
    "ScopeMember": {
      "type": "object",
      "properties": {
        "relation_ref": {
          "$ref": "context-schemas.json#/$defs/VersionedRef"
        },
        "member_ref": {
          "$ref": "context-schemas.json#/$defs/VersionedRef"
        }
      },
      "required": [
        "relation_ref",
        "member_ref"
      ],
      "additionalProperties": false
    },
    "TraversalScope": {
      "type": "object",
      "properties": {
        "scope_id": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/ScopeMember"
          }
        }
      },
      "required": [
        "scope_id",
        "members"
      ],
      "additionalProperties": false
    },
    "EvidenceAnchor": {
      "type": "object",
      "properties": {
        "document_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parser_version": {
          "type": "string"
        },
        "structure_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_id": {
          "type": "string"
        },
        "section_node_id": {
          "type": "string"
        },
        "block_id": {
          "type": "string"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "fragment_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "table_path": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "row_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "column_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "span_start": {
          "type": "integer",
          "minimum": 0
        },
        "span_end": {
          "type": "integer",
          "minimum": 1
        },
        "physical_page_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "document_hash",
        "parser_version",
        "structure_hash",
        "evidence_id",
        "section_node_id",
        "block_id",
        "paragraph_index",
        "fragment_index",
        "table_path",
        "row_index",
        "column_index",
        "span_start",
        "span_end",
        "physical_page_number"
      ],
      "additionalProperties": false
    },
    "VerificationTargetSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "target_id": {
              "type": "string"
            },
            "target_kind": {
              "const": "entity"
            },
            "claim_ref": {
              "$ref": "context-schemas.json#/$defs/VersionedRef"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payload": {
              "$ref": "urn:ontology-tool-extraction:discovery#/$defs/EntityProposal"
            },
            "scope": {
              "$ref": "context-schemas.json#/$defs/TraversalScope"
            },
            "dependency_refs": {
              "type": "array",
              "items": {
                "$ref": "context-schemas.json#/$defs/VersionedRef"
              }
            },
            "required_facets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "target_id",
            "target_kind",
            "claim_ref",
            "content_hash",
            "payload",
            "scope",
            "dependency_refs",
            "required_facets"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "target_id": {
              "type": "string"
            },
            "target_kind": {
              "const": "reference_binding"
            },
            "claim_ref": {
              "$ref": "context-schemas.json#/$defs/VersionedRef"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payload": {
              "$ref": "urn:ontology-tool-extraction:discovery#/$defs/ReferenceBindingProposal"
            },
            "scope": {
              "$ref": "context-schemas.json#/$defs/TraversalScope"
            },
            "dependency_refs": {
              "type": "array",
              "items": {
                "$ref": "context-schemas.json#/$defs/VersionedRef"
              }
            },
            "required_facets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "target_id",
            "target_kind",
            "claim_ref",
            "content_hash",
            "payload",
            "scope",
            "dependency_refs",
            "required_facets"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "target_id": {
              "type": "string"
            },
            "target_kind": {
              "const": "property"
            },
            "claim_ref": {
              "$ref": "context-schemas.json#/$defs/VersionedRef"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payload": {
              "$ref": "urn:ontology-tool-extraction:discovery#/$defs/PropertyProposal"
            },
            "scope": {
              "$ref": "context-schemas.json#/$defs/TraversalScope"
            },
            "dependency_refs": {
              "type": "array",
              "items": {
                "$ref": "context-schemas.json#/$defs/VersionedRef"
              }
            },
            "required_facets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "target_id",
            "target_kind",
            "claim_ref",
            "content_hash",
            "payload",
            "scope",
            "dependency_refs",
            "required_facets"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "target_id": {
              "type": "string"
            },
            "target_kind": {
              "const": "relation"
            },
            "claim_ref": {
              "$ref": "context-schemas.json#/$defs/VersionedRef"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payload": {
              "$ref": "urn:ontology-tool-extraction:discovery#/$defs/RelationProposal"
            },
            "scope": {
              "$ref": "context-schemas.json#/$defs/TraversalScope"
            },
            "dependency_refs": {
              "type": "array",
              "items": {
                "$ref": "context-schemas.json#/$defs/VersionedRef"
              }
            },
            "required_facets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "target_id",
            "target_kind",
            "claim_ref",
            "content_hash",
            "payload",
            "scope",
            "dependency_refs",
            "required_facets"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "target_id": {
              "type": "string"
            },
            "target_kind": {
              "const": "external_link"
            },
            "claim_ref": {
              "$ref": "context-schemas.json#/$defs/VersionedRef"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payload": {
              "$ref": "urn:ontology-tool-extraction:discovery#/$defs/ExternalLinkProposal"
            },
            "scope": {
              "$ref": "context-schemas.json#/$defs/TraversalScope"
            },
            "dependency_refs": {
              "type": "array",
              "items": {
                "$ref": "context-schemas.json#/$defs/VersionedRef"
              }
            },
            "required_facets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "target_id",
            "target_kind",
            "claim_ref",
            "content_hash",
            "payload",
            "scope",
            "dependency_refs",
            "required_facets"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EntityDependencyView": {
      "type": "object",
      "properties": {
        "entity_ref": {
          "$ref": "context-schemas.json#/$defs/VersionedRef"
        },
        "class_iri": {
          "type": "string"
        },
        "grounding_kind": {
          "type": "string",
          "enum": [
            "document_root",
            "mention",
            "record"
          ]
        },
        "root_origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposal": {
          "anyOf": [
            {
              "$ref": "urn:ontology-tool-extraction:discovery#/$defs/EntityProposal"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/EvidenceAnchor"
          }
        },
        "dependency_refs": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/VersionedRef"
          }
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "entity_ref",
        "class_iri",
        "grounding_kind",
        "root_origin",
        "proposal",
        "source_refs",
        "dependency_refs",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "ExternalCandidate": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "dataset": {
          "type": "string"
        },
        "record_key": {
          "type": "string"
        },
        "record_version": {
          "type": "string"
        },
        "class_iri": {
          "type": "string"
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "predicate_iri": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "document_quote": {
                "$ref": "urn:ontology-tool-extraction:discovery#/$defs/Quote"
              },
              "record_field": {
                "type": "string"
              },
              "record_value": {
                "type": "string"
              },
              "match_kind": {
                "type": "string",
                "enum": [
                  "exact_key",
                  "key_component",
                  "name",
                  "alias"
                ]
              }
            },
            "required": [
              "predicate_iri",
              "document_quote",
              "record_field",
              "record_value",
              "match_kind"
            ],
            "additionalProperties": false
          }
        },
        "mapped_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "predicate_iri": {
                "type": "string"
              },
              "raw_value": {
                "type": "string"
              },
              "datatype_iri": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "predicate_iri",
              "raw_value",
              "datatype_iri"
            ],
            "additionalProperties": false
          }
        },
        "metadata": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "candidate_id",
        "source_id",
        "system",
        "dataset",
        "record_key",
        "record_version",
        "class_iri",
        "matches",
        "mapped_fields",
        "metadata"
      ],
      "additionalProperties": false
    },
    "BridgeStepView": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "referent_binding",
            "owner_binding",
            "predicate_assertion"
          ]
        },
        "subject_ref": {
          "$ref": "context-schemas.json#/$defs/VersionedRef"
        },
        "object_ref": {
          "anyOf": [
            {
              "$ref": "context-schemas.json#/$defs/VersionedRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "predicate_iri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/EvidenceAnchor"
          }
        }
      },
      "required": [
        "kind",
        "subject_ref",
        "object_ref",
        "predicate_iri",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "BridgeDependencyView": {
      "type": "object",
      "properties": {
        "bridge_id": {
          "type": "string"
        },
        "bridge_ref": {
          "$ref": "context-schemas.json#/$defs/VersionedRef"
        },
        "bridge_kind": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/BridgeStepView"
          }
        },
        "dependency_refs": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/VersionedRef"
          }
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "bridge_id",
        "bridge_ref",
        "bridge_kind",
        "steps",
        "dependency_refs",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "GroundedScopeQualifier": {
      "type": "object",
      "properties": {
        "predicate_iri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/EvidenceAnchor"
          }
        }
      },
      "required": [
        "predicate_iri",
        "text",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "VerificationScopeStep": {
      "type": "object",
      "properties": {
        "relation_ref": {
          "$ref": "context-schemas.json#/$defs/VersionedRef"
        },
        "member_ref": {
          "$ref": "context-schemas.json#/$defs/VersionedRef"
        },
        "selection": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "all",
                "one_of",
                "alternatives",
                "undetermined"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "polarity": {
          "type": "string",
          "enum": [
            "affirmed",
            "negated"
          ]
        },
        "modality": {
          "type": "string",
          "enum": [
            "asserted",
            "required",
            "possible",
            "planned",
            "unspecified"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applicability": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/GroundedScopeQualifier"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/EvidenceAnchor"
          }
        }
      },
      "required": [
        "relation_ref",
        "member_ref",
        "selection",
        "polarity",
        "modality",
        "conditions",
        "applicability",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "VerificationScopeResolution": {
      "type": "object",
      "properties": {
        "scope_id": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
