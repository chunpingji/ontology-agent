          ]
        },
        "evidence_id": {
          "type": "string"
        },
        "span_start": {
          "type": "integer",
          "minimum": 0
        },
        "span_end": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "type": "string"
        },
        "fact_eligible": {
          "type": "boolean"
        }
      },
      "required": [
        "record_id",
        "evidence_id",
        "span_start",
        "span_end",
        "role",
        "fact_eligible"
      ],
      "additionalProperties": false
    },
    "ContextBindingRefs": {
      "type": "object",
      "properties": {
        "endpoint_evidence": {
          "type": "array",
          "items": {
