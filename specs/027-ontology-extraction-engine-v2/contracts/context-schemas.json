          }
        },
        "proof_dependencies": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/VersionedRef"
          }
        },
        "competing_subject_refs": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/VersionedRef"
          }
        },
        "subject_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/EvidenceAnchor"
          }
        },
        "owner_field_refs": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/EvidenceAnchor"
          }
        },
        "required_context_refs": {
          "type": "array",
          "items": {
            "$ref": "context-schemas.json#/$defs/EvidenceAnchor"
