      "\"\"\"\n{\n  \"version\": 1,\n  \"sources\": [\n    {\n      \"locator\": \"table_rows\",\n      \"headers\": {\n        \"all_of\": [\n          {\"any_of\": [\"活性成分(API)\", \"活性成分（API）\", \"活性成分\", \"API\"]},\n          {\"any_of\": [\"试验项目\", \"试验类型\", \"毒理研究\"]}\n        ]\n      },\n      \"endpoint_mode\": \"row\",\n      \"source_label\": \"宽表毒理\",\n      \"identity\": {\"fields\": [\"activeIngredient\", \"studyType\"]}\n    },\n    {\n      \"locator\": \"table_singleton\",\n      \"headers\": {\n        \"all_of\": [\n          {\"any_of\": [\"参数\"]},\n          {\"any_of\": [\"数值\", \"值\"]}\n        ]\n      },\n      \"orientation\": \"kv\",\n      \"key_aliases\": [\"参数\"],\n      \"value_aliases\": [\"数值\", \"值\"],\n      \"source_label\": \"共线评估参数\",\n      \"identity\": {\"fallback\": \"共线评估数据\"}\n    }\n  ],\n  \"identity\": {\"fallback\": \"共线评估数据\"},\n  \"property_aliases\": {\n    \"activeIngredient\": [\"活性成分(API)\", \"活性成分（API）\", \"活性成分\", \"API\"],\n    \"studyType\": [\"试验项目\", \"试验类型\", \"毒理研究\"],\n    \"noael_mg_per_kg_per_day\": [\"NOAEL\", \"NOAEL（大鼠）\", \"NOAEL（犬）\"],\n    \"noaelSpecies\": [\"动物种属\", \"种属\", \"NOAEL动物种属\"],\n    \"noaelDuration\": [\"试验周期\", \"给药周期\", \"NOAEL试验周期\"],\n    \"safetyFactor\": [\"F值\", \"安全系数\", \"总安全系数\"],\n    \"humanEquivalentDose_mg_per_kg\": [\"人体等效剂量\", \"HED\"],\n    \"proposedStartingDose_mg\": [\"拟定临床起始剂量\", \"临床起始剂量\"],\n    \"proposedMaxDose_mg\": [\"拟定最高剂量\", \"最高剂量\"],\n    \"dosingRegimen\": [\"给药方案\", \"给药频次\"],\n    \"f1\": [\"F1\"],\n    \"f2\": [\"F2\"],\n    \"f3\": [\"F3\"],\n    \"f4\": [\"F4\"],\n    \"f5\": [\"F5\"],\n    \"pde_mg_per_day\": [\"PDE (mg/天)\", \"PDE（mg/天）\", \"PDE\"],\n    \"sourceReference\": [\"来源\", \"数据来源\", \"参考文献\"],\n    \"oebBand\": [\"OEB\", \"OEB分级\", \"OEB等级\"]\n  },\n  \"transforms\": {\n    \"noael_mg_per_kg_per_day\": {\n      \"type\": \"cast\",\n      \"config\": {\n        \"to\": \"decimal\",\n        \"number_pattern\": \"[-+]?[0-9]+(?:[.][0-9]