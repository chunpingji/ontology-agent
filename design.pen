                                      "width": "fill_container",
                                      "content": "2.4  溶出度：各时间点溶出量均 ≥85%（Q=80%），30 分钟内溶出度符合规定。",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 14,
                                      "fontWeight": "normal"
