                          "fill": "#e0e0e0",
                          "width": "fill_container",
                          "height": 1
                        },
                        {
                          "type": "text",
                          "id": "ZkR3Q",
                          "name": "Section 1 Title",
                          "fill": "#222222",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "一、总则",
                          "fontFamily": "Noto Serif SC",
                          "fontSize": 15,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "R9Izp",
                          "name": "Section 1 Body",
                          "fill": "#333333",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "1.1　为规范药品剂型的分类与命名，保障药品注册、生产和流通环节的一致性与可追溯性，根据《中华人民共和国药品管理法》及相关法规，制定本标准。\n\n1.2　本标准适用于化学药品、生物制品和中药各类剂型的分类、编码与命名。各药品上市许可持有人、生产企业应当按照本标准执行剂型申报。",
                          "lineHeight": 1.8,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "q7Yyo",
                          "name": "Section 2 Title",
                          "fill": "#222222",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "二、剂型分类体系",
                          "fontFamily": "Noto Serif SC",
                          "fontSize": 15,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "XPMb0",
                          "name": "Section 2 Body",
                          "fill": "#333333",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "2.1　口服固体制剂：片剂、胶囊剂、颗粒剂、丸剂、散剂等。\n2.2　口服液体制剂：口服溶液剂、口服混悬剂、口服乳剂、糖浆剂等。\n2.3　注射剂：注射液、注射用无菌粉末、注射用浓溶液等。\n2.4　外用制剂：软膏剂、乳膏剂、凝胶剂、贴剂、喷雾剂等。",
                          "lineHeight": 1.8,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
