  "blocks": [
    {
      "block_id": "paragraph:0:0",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "本报告设备清单列出反应釜 R-101，物料在该釜内混合反应。",
      "style_name": "Normal",
      "heading_level": 0,
      "section_node_id": "document",
      "physical_page_number": null,
      "body_index": 0,
      "block_type": "paragraph"
    },
    {
      "block_id": "paragraph:1:0",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "The CMC report lists Reactor R-202 as the vessel used for synthesis.",
      "style_name": "Normal",
      "heading_level": 0,
      "section_node_id": "document",
      "physical_page_number": null,
      "body_index": 1,
      "block_type": "paragraph"
    },
    {
      "block_id": "paragraph:2:0",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "本报告工艺使用反应器 R-103 完成缩合反应。",
      "style_name": "Normal",
      "heading_level": 0,
      "section_node_id": "document",
      "physical_page_number": null,
      "body_index": 2,
      "block_type": "paragraph"
    },
    {
      "block_id": "paragraph:3:0",
      "paragraph_index": 3,
      "fragment_index": 0,
      "text": "本报告明确不使用反应釜 R-303，该设备的租用计划已取消。",
      "style_name": "Normal",
      "heading_level": 0,
      "section_node_id": "document",
      "physical_page_number": null,
      "body_index": 3,
      "block_type": "paragraph"
    },
    {
      "block_id": "paragraph:4:0",
      "paragraph_index": 4,
      "fragment_index": 0,
      "text": "仅在放大批次阶段，本报告工艺才使用反应釜 R-404。",
      "style_name": "Normal",
      "heading_level": 0,
      "section_node_id": "document",
      "physical_page_number": null,
      "body_index": 4,
      "block_type": "paragraph"
    },
    {
      "block_id": "paragraph:5:0",
      "paragraph_index": 5,
      "fragment_index": 0,
      "text": "培训资料介绍反应器的工作原理，不涉及本报告选用的设备。",
      "style_name": "Normal",
      "heading_level": 0,
      "section_node_id": "document",
      "physical_page_number": null,
      "body_index": 5,
      "block_type": "paragraph"
    },
    {
      "block_id": "paragraph:6:0",
      "paragraph_index": 6,
      "fragment_index": 0,
      "text": "行政会议室的桌椅按照日程进行整理。",
      "style_name": "Normal",
      "heading_level": 0,
      "section_node_id": "document",
      "physical_page_number": null,
      "body_index": 6,
      "block_type": "paragraph"
    },
    {
      "block_id": "paragraph:7:0",
      "paragraph_index": 7,
      "fragment_index": 0,
      "text": "成品包装盒采用蓝色图案，产品名称印在外包装正面。",
      "style_name": "Normal",
      "heading_level": 0,
      "section_node_id": "document",
      "physical_page_number": null,
      "body_index": 7,
      "block_type": "paragraph"
    }
  ],
